{
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.char": "May I touch you? Just for a moment! Hehe…",
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.ancient": "No… fear… So curious…",
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.1-visit": "1",
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.char": "I wonder what fascinating new things I’ll learn this time?",
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.next": "Continue",
  "NEOW.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.ancient": "The Spire… will give you… answers…",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.char": "What animal are you riding? Could I have a turn?",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.ancient": "Careful, lass! My old friend has a temper. Don’t go breaking a leg!",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.1-visit": "1",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.char": "You have so many fascinating treasures—may I take a look?",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.next": "Continue",
  "DARV.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.ancient": "A look? Of course! Plenty here. Pick whatever takes your fancy!",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.char": "How fascinating! May I touch you? Just once!",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.ancient": "Such… enthusiasm…",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.1-visit": "1",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.ancient": "Take a part of me… Go…",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.next": "Continue",
  "PAEL.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.char": "Thank you! Hey, wait, Lumi! You can’t eat that!",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.ancient": "New one, pink one! And a little stone?",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.char": "This is Lumi, my partner!",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.1-visit": "1",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.ancient": "Pink one, wings, on top of head?",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.next": "Continue",
  "OROBAS.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.char": "Hehe, your eye is beautiful too!",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.ancient": "Come warm yourself by my side, dear child.",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.char": "Wow… It’s so bright in here, you’d hardly know we were inside the Spire!",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.1-visit": "1",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.char": "These treats are delicious! Slow down, Lumi!",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.next": "Continue",
  "TEZCATARA.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.ancient": "Then have some more. Build up your strength before you go.",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.ancient": "What a lively young lady. Let’s dress you up. You’ll be even more dazzling.",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.char": "Something this precious… may I really take all of it?",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.1-visit": "1",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.char": "Lumi, you can’t eat that! Spit it out!",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.next": "Continue",
  "NONUPEIPE.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.ancient": "Hehe, never mind. If the little one likes it, let it keep it.",
  "VAKUU.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "VAKUU.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.ancient": "Lovely lady, I have some ornaments worthy of you. Do put them on.",
  "VAKUU.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "VAKUU.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.char": "They look a little strange…",
  "VAKUU.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.next": "Continue",
  "VAKUU.talk.STS2_LINNEA_CHARACTER_LINNEA.0-2r.ancient": "And our little guest? Oh, it seems to prefer jewels and ore.",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-visit": "0",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.char": "Is this… the very top of the Spire?",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-0r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.ancient": "…Another deluded fool.",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-1r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-2r.char": "Why do you say that? And who are you?",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-2r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.0-3r.ancient": "The answers you seek are not here. Go back.",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-visit": "1",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.char": "Ta-da! I’m back!",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-0r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.ancient": "Pointless. Is finding more life-forms all you do?",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-2r.char": "Speaking of which, you don’t look quite like an ordinary human either.",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-2r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.1-3r.ancient": "That is none of your concern.",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-visit": "2",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-0r.char": "Let me see… Yes, I’ll put you on this page.",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-0r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-1r.ancient": "You attempt to define me? Foolish.",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-2r.char": "Easy, easy! After climbing all this way, surely you can let me catch my breath?",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-2r.next": "Continue",
  "THE_ARCHITECT.talk.STS2_LINNEA_CHARACTER_LINNEA.2-3r.ancient": "…"
}
